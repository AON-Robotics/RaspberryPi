# Copy to .env (same folder) and fill in. .env is git-ignored: never commit it.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Robot server (Mac now, Pi later), by Tailscale IP or name.
BRIDGE_URL=http://<robot-server-tailscale-ip>:8000
# Same value as the robot server's BRIDGE_TOKEN (at least 32 characters).
BRIDGE_TOKEN=<token>
# Password teammates type to open the chat (at least 16 characters).
# Not the robot token: that one never leaves this laptop.
TEAM_PASSWORD=<team-password>
# Address the chat is published on: this laptop's Tailscale IP
# (`tailscale ip -4`). Leave unset for this laptop only (127.0.0.1).
# BIND_IP=<laptop-tailscale-ip>
# MODEL=qwen3:8b
